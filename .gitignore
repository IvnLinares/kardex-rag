# Env
.env
.env.*
!.env.example

# Backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/*.pyc
backend/.pytest_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/

# Frontend
frontend/node_modules/
frontend/dist/

# Tool caches that may land at repo root (e.g. pre-commit hooks)
.ruff_cache/
.pytest_cache/

# Claude Code local config (settings.json es compartido, se commitea)
.claude/*
!.claude/settings.json

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Contexto de proyecto para el asistente de IA -- solo local, no en el repo
# publico (documenta decisiones/bugs internos del desarrollo, no secretos).
/CLAUDE.md
/INSTRUCTIVO_DIA_1.md

# OS / editor
.DS_Store
*.log
