# Copiar este archivo como .env y ajustar valores. NUNCA commitear el .env real.

# --- Base de datos (PostgreSQL + pgvector) ---
POSTGRES_USER=kardex_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kardex_rag
# Puerto host 5433 (no 5432) para evitar choques con un PostgreSQL nativo local
DATABASE_URL=postgresql://kardex_admin:changeme@localhost:5433/kardex_rag

# --- LLM: Opción A (por defecto) — Ollama local, sin costo, corre en Docker ---
# phi3 (3.8B, ~2.3GB) elegido por RAM disponible (16GB con entorno de desarrollo activo).
# Si tu PC lo soporta cómodo más adelante, podés cambiar a llama3 (8B, ~4.7GB) sin tocar código.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
# Modelo de embeddings local (~274MB): docker exec -it kardex_rag_ollama ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- LLM: Opción B — OpenAI (comentar la Opción A si usás esta) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vue + Vite) ---
VITE_API_URL=http://localhost:8000
